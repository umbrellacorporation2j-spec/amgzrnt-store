rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'admin@amgzrnt.app';
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function ownsApp() {
      return signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.devId == request.auth.uid
      );
    }
    function appOwner(appId) {
      let a = get(/databases/$(database)/documents/apps/$(appId)).data;
      return signedIn() && (a.get('ownerUid', '') == request.auth.uid || a.get('devId', '') == request.auth.uid);
    }
    function validUrl(u) { return u is string && u.matches('^https?://[^ ]+$') && u.size() <= 2000; }
    // Fields only the admin may change (a developer can never un-suspend or edit the admin's notes).
    function adminFields() {
      return ['suspended', 'suspendedReason', 'suspendedAt', 'adminNote', 'adminNoteAt', 'ownerUid', 'devId'];
    }

    match /apps/{appId} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn() &&
        (request.resource.data.ownerUid == request.auth.uid || request.resource.data.devId == request.auth.uid) &&
        validUrl(request.resource.data.url) &&
        (!('suspended' in request.resource.data) || request.resource.data.suspended == false) &&
        !('adminNote' in request.resource.data));
      allow update: if isAdmin() || (ownsApp() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminFields()) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['url']) || validUrl(request.resource.data.url)));
      allow delete: if isAdmin() || ownsApp();

      match /ratings/{ratingId} {
        function validRating() {
          let d = request.resource.data;
          return d.keys().hasOnly(['stars', 'name', 'text', 'at', 'kind'])
            && d.kind in ['review', 'complaint', 'suggest']
            && (!('stars' in d) || (d.stars is number && d.stars >= 0 && d.stars <= 5))
            && (!('name' in d) || (d.name is string && d.name.size() <= 60))
            && (!('text' in d) || (d.text is string && d.text.size() <= 600))
            && (!('at' in d) || d.at == request.time);
        }
        function mine() { return signedIn() && ratingId.matches(request.auth.uid + '_.*'); }
        allow read: if true;
        // anyone can post once per device/account id; the admin can post official reviews
        allow create: if isAdmin() || validRating();
        // signed-in users edit their own review (document id starts with their uid);
        // the app owner may only add/remove a public reply; the admin may edit anything
        allow update: if isAdmin()
          || (mine() && validRating())
          || (appOwner(appId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'replyAt', 'replyBy', 'replyName']));
        allow delete: if isAdmin() || mine();
      }
      match /views/{viewId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isOwner(uid) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user'));
      allow update: if isAdmin() || (isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','deleted']));
      allow delete: if isAdmin();

      match /installedApps/{appId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /notifications/{noticeId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isAdmin();
        allow update: if isAdmin() || (isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
        allow delete: if isOwner(uid) || isAdmin();
      }
    }
  }
}
